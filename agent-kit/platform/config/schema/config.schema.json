{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlatformConfig",
  "type": "object",
  "required": ["app", "tracing", "db", "http"],
  "properties": {
    "app": {
      "type": "object",
      "required": ["name", "environment"],
      "properties": {
        "name": { "type": "string" },
        "environment": { "type": "string" }
      }
    },
    "tracing": {
      "type": "object",
      "required": ["enabled", "errorSampleRate"],
      "properties": {
        "enabled": { "type": "boolean" },
        "errorSampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "defaultSampleRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "db": {
      "type": "object",
      "required": ["compat", "pool"],
      "properties": {
        "compat": {
          "type": "object",
          "required": ["minSupportedSchemaVersion"],
          "properties": {
            "minSupportedSchemaVersion": { "type": "string" }
          }
        },
        "pool": {
          "type": "object",
          "required": ["maxOpenConns", "statementTimeoutMs"],
          "properties": {
            "maxOpenConns": { "type": "integer" },
            "maxIdleConns": { "type": "integer" },
            "connMaxLifetimeSeconds": { "type": "integer" },
            "statementTimeoutMs": { "type": "integer" }
          }
        }
      }
    },
    "http": {
      "type": "object",
      "required": ["client"],
      "properties": {
        "client": {
          "type": "object",
          "required": ["timeoutMs"],
          "properties": {
            "timeoutMs": { "type": "integer" },
            "maxRetries": { "type": "integer" }
          }
        }
      }
    }
  }
}
