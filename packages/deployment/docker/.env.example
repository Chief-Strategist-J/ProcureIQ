POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=procureiq

ALLOYDB_PORT=5432
ALLOYDB_HOST=alloydb-omni

TEMPO_GRPC_PORT=4317
TEMPO_HTTP_PORT=4318
TEMPO_QUERY_PORT=3200
TEMPO_CONFIG_FILE=/etc/tempo.yaml

GRAFANA_PORT=3001
GRAFANA_INTERNAL_PORT=3000
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=true

SPRINGBOOT_DATASOURCE_URL=jdbc:postgresql://alloydb-omni:5432/procureiq
SPRINGBOOT_DATASOURCE_USERNAME=postgres
SPRINGBOOT_DATASOURCE_PASSWORD=postgres
SPRINGBOOT_OTEL_SERVICE_NAME=springboot-app
SPRINGBOOT_OTEL_TRACES_EXPORTER=otlp
SPRINGBOOT_OTEL_EXPORTER_ENDPOINT=http://tempo:4317
SPRINGBOOT_OTEL_METRICS_EXPORTER=none
SPRINGBOOT_OTEL_LOGS_EXPORTER=none

NEXTJS_API_URL=http://springboot-app:8080/api/v1
NEXTJS_DATABASE_URL=postgresql://postgres:postgres@alloydb-omni:5432/procureiq
NEXTJS_OTEL_ENDPOINT=http://tempo:4318/v1/traces

TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
