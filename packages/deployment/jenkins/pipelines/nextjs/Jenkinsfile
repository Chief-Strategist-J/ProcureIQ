import groovy.json.JsonSlurper

@NonCPS
def getDirectory(String configText, String key) {
    return new JsonSlurper().parseText(configText)[key]
}

pipeline {
    agent {
        node {
            label ''
            customWorkspace '/workspace'
        }
    }

    stages {
        stage('Frontend Tests') {
            steps {
                script {
                    def configText = readFile('packages/deployment/scripts/jenkins/config.json')
                    def targetDir = getDirectory(configText, 'nextjs_dir')
                    dir(targetDir) {
                        sh 'npm install'
                        sh 'npm run test'
                    }
                }
            }
        }
    }
}
